{
  "name": "@bugcrumbs/screenshot",
  "version": "0.1.0",
  "description": "DOM screenshot for Bugcrumbs reports, loaded on demand",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kiridharan/bugcrumbs.git",
    "directory": "packages/screenshot"
  },
  "homepage": "https://github.com/kiridharan/bugcrumbs#readme",
  "bugs": "https://github.com/kiridharan/bugcrumbs/issues",
  "keywords": [
    "screenshot",
    "dom-screenshot",
    "bug-report",
    "qa"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
