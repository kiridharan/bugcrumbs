{
  "name": "@bugcrumbs/react",
  "version": "0.1.0",
  "description": "React devtools widget and error capture for Bugcrumbs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kiridharan/bugcrumbs.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/kiridharan/bugcrumbs#readme",
  "bugs": "https://github.com/kiridharan/bugcrumbs/issues",
  "keywords": [
    "react",
    "bug-report",
    "qa",
    "devtools",
    "error-boundary",
    "feedback-widget",
    "testing"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
